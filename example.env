# Copy to .env and fill API_USERNAME, API_PASSWORD, and REDIS_PASSWORD.
# Never commit .env. Values below are defaults, not working account credentials.
# Container image followed by Watchtower. latest tracks the repository default branch.
# For the current rewrite preview, use :rewrite-bun-cloakbrowser instead.
APP_IMAGE=ghcr.io/jamesflare1212/dsas-cca-backend:latest
WATCHTOWER_POLL_INTERVAL=300
# Watchtower 1.7.1 defaults to an obsolete Docker API; use the host-compatible API.
WATCHTOWER_DOCKER_API_VERSION=1.44
# Private GHCR only: dedicated docker login config used by docker-compose.auth.yaml.
# WATCHTOWER_AUTH_DIR=./.watchtower-auth

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Engage: encodeURIComponent each credential separately for legacy compatibility.
# Set false if supplying literal, unencoded credentials instead.
API_BASE_URL=https://engage.nkcswx.cn
API_USERNAME=
API_PASSWORD=
API_CREDENTIALS_URL_ENCODED=true
AUTH_LOGIN_TIMEOUT_MS=60000
AUTH_FAILURE_COOLDOWN_MS=30000

# Local application state; Compose overrides DATA_DIR to /usr/src/app/data.
DATA_DIR=./data
# Local Bun uses REDIS_URL; Compose derives its URL from REDIS_PASSWORD below.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=dsas:v2
# Required for Compose. Generate a URL-safe secret, e.g. openssl rand -hex 32.
# Compose passes the same password to Redis and the application's Redis URL.
REDIS_PASSWORD=

# Browser settings are read by CloakBrowser, not src/config.ts.
# The image supplies /opt/cloakbrowser; leave local cache location at its default.
CLOAKBROWSER_AUTO_UPDATE=false
# CLOAKBROWSER_CACHE_DIR=/absolute/path/to/a/writable/browser-cache
# The default free binary needs no license. Supply a key externally only if needed.
# CLOAKBROWSER_LICENSE_KEY=

# Comma-separated exact origins (no trailing slash), or *.
ALLOWED_ORIGINS=*
HTTP_REQUESTS_PER_MINUTE=600
HTTP_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=15000

# Activity discovery is inclusive; max - min must be between 0 and 100000.
FIXED_STAFF_ACTIVITY_ID=7095
MIN_ACTIVITY_ID_SCAN=3000
MAX_ACTIVITY_ID_SCAN=8000
CONCURRENT_API_CALLS=4
MAX_PENDING_FETCHES=256
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_RETRIES=2
CRAWLER_RETRY_DELAY_MS=1000
# 0 disables the outbound rate limit.
CRAWLER_REQUESTS_PER_MINUTE=120
MAX_UPSTREAM_RESPONSE_BYTES=20000000
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_MS=30000

# Positive cache records persist; these intervals control freshness, not Redis TTL.
CLUB_UPDATE_INTERVAL_MINS=360
STAFF_UPDATE_INTERVAL_MINS=360
CLUB_CHECK_INTERVAL_SECONDS=60
STAFF_CHECK_INTERVAL_SECONDS=60
DISCOVERY_INTERVAL_MINS=360
# Negative activity results are fresh for this many seconds.
ERROR_CACHE_TTL=3600
FAILED_FETCH_RETRY_SECONDS=60
SCHEDULER_ENABLED=true

# S3 is optional. Configure bucket + both access credentials together.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL_PREFIX=files
IMAGE_MAX_INPUT_BYTES=10000000
IMAGE_MAX_PIXELS=24000000
IMAGE_CONCURRENCY=2
IMAGE_PROCESS_TIMEOUT_MS=10000

# Integration tests only: use a separate disposable Redis database/instance.
# RUN_REDIS_TESTS=1
# TEST_REDIS_URL=redis://127.0.0.1:6379/0
