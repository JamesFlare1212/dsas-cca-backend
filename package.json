{
  "name": "dsas-cca-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test ./tests",
    "test:corpus": "bun test ./tests/engage-corpus.test.ts",
    "test:corpus:raw": "bun run scripts/verify-engage-raw.ts",
    "test:corpus:validation": "CORPUS_PARTITION=validation bun test ./tests/engage-corpus.test.ts",
    "corpus:capture": "bun run scripts/capture-engage-corpus.ts",
    "corpus:build": "bun run scripts/build-engage-corpus.ts",
    "test:integration": "RUN_REDIS_TESTS=1 bun test ./tests/redis.test.ts ./tests/runtime.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test",
    "browser:install": "bun run scripts/install-browser.ts",
    "browser:smoke": "bun run scripts/browser-smoke.ts",
    "cookie:get": "bun run scripts/login.ts",
    "cache:migrate": "bun run scripts/migrate-cache.ts",
    "test:browser": "RUN_BROWSER_TESTS=1 bun test ./tests/browser.test.ts ./tests/docs-browser.test.ts"
  },
  "dependencies": {
    "cloakbrowser": "0.6.4",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "pangu": "10.4.1",
    "pino": "10.4.0",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  }
}
